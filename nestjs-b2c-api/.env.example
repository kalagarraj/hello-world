# ---------------------------------------------------------------------------
# Azure AD B2C -- must be the same tenant and user flow as the web app
# ---------------------------------------------------------------------------
B2C_TENANT_NAME=contoso
B2C_POLICY_NAME=B2C_1_signupsignin
# Or set the discovery URL directly (custom domains, *.ciamlogin.com tenants):
# B2C_DISCOVERY_URL=https://contoso.b2clogin.com/contoso.onmicrosoft.com/B2C_1_signupsignin/v2.0/.well-known/openid-configuration

# OPTIONAL, and unset by default so the web app's existing bearer token works
# with no extra setup. Leave it unset and any unexpired token this tenant signed
# is accepted -- including tokens issued to other applications.
#
# Set it before deploying: the Application (client) ID of THIS API's own app
# registration, so only tokens addressed here are accepted.
# B2C_API_AUDIENCE=00000000-0000-0000-0000-000000000000

# OPTIONAL: also require this scope in the token's `scp` claim. The short name
# as it appears in the token, e.g. "api.read", not the URI the client requests.
# B2C_REQUIRED_SCOPE=api.read

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=3001
# Origin allowed to call this API from a browser; the web app runs here.
CORS_ORIGIN=http://localhost:3000
