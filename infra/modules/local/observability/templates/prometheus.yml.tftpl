global:
  scrape_interval: 15s
  evaluation_interval: 15s
  external_labels:
    environment: local
    stack: ${stack}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Metrics the OpenTelemetry Collector receives over OTLP and re-exposes.
  - job_name: otel-collector
    static_configs:
      - targets: ["otel-collector:8889"]

  # Collector self-telemetry.
  - job_name: otel-collector-internal
    static_configs:
      - targets: ["otel-collector:8888"]
%{ for app in apps ~}

  - job_name: ${app.name}
    metrics_path: ${app.metrics_path}
    static_configs:
      - targets: ["${app.target}"]
        labels:
          service_name: ${app.name}
%{ endfor ~}
