# ---------------------------------------------------------------------------
# Azure AD B2C
# ---------------------------------------------------------------------------
# Tenant name only, i.e. "contoso" for contoso.onmicrosoft.com
B2C_TENANT_NAME=contoso
# The sign-up/sign-in user flow, e.g. B2C_1_signupsignin
B2C_POLICY_NAME=B2C_1_signupsignin

# Optional: set this to override the derived discovery URL (custom domains,
# *.ciamlogin.com tenants, or custom policies).
# B2C_DISCOVERY_URL=https://contoso.b2clogin.com/contoso.onmicrosoft.com/B2C_1_signupsignin/v2.0/.well-known/openid-configuration

# Application (client) ID of the app registration
B2C_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret created under Certificates & secrets (copy the "Value" column,
# it is shown only once). Leave EMPTY if the app registration is a public
# client -- i.e. the redirect URI sits under "Mobile and desktop applications",
# or "Allow public client flows" is Yes. Such a registration rejects a secret
# with AADB2C90084, and the app then authenticates with PKCE alone.
B2C_CLIENT_SECRET=replace-me

# Must match a redirect URI registered on the app registration (type: Web)
B2C_REDIRECT_URI=http://localhost:3000/auth/callback
B2C_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/
B2C_SCOPE=openid profile email offline_access
# The companion API in ../nestjs-b2c-api accepts the token this already produces.
# Only if you turn on its audience check do you need to append its exposed scope,
# so B2C issues an access token addressed to it, e.g.
# B2C_SCOPE=openid profile email offline_access https://contoso.onmicrosoft.com/<api-app>/api.read

# ---------------------------------------------------------------------------
# Environment & session storage
# ---------------------------------------------------------------------------
# Logical environment: local, dev, test, prod, ... Anything other than "local"
# requires a shared session store (or an explicit opt-out below).
APP_ENV=local

# auto (default) uses Redis when REDIS_URL is set and the in-process store
# otherwise. Force it with "redis" or "memory".
SESSION_STORE=auto

# Local: start the container with `npm run redis:up`, then uncomment this.
# Leave unset to keep sessions in process instead -- no container needed.
# REDIS_URL=redis://localhost:6379
#
# Azure Cache for Redis requires TLS, hence rediss:// and port 6380.
# Portal -> your Redis resource -> Access keys -> Primary connection string.
# REDIS_URL=rediss://:<access-key>@<name>.redis.cache.windows.net:6380

# Namespaces keys so environments sharing one cache cannot collide.
# Defaults to sess:<APP_ENV>:
# SESSION_KEY_PREFIX=sess:dev:

# Accept the in-process store outside local. Sessions are then lost on restart
# and not shared between instances -- only for a throwaway environment.
# SESSION_ALLOW_MEMORY_STORE=false

SESSION_COOKIE_NAME=b2c.sid
# Defaults to true whenever APP_ENV is not local.
# SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_MS=3600000

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# The companion API in ../nestjs-b2c-api, called by the demo links on the home
# and welcome pages.
DEMO_API_URL=http://localhost:3001/hello
PORT=3000
NODE_ENV=development
# Use a long random value in production, e.g. `openssl rand -base64 32`
SESSION_SECRET=change-me

# Step-by-step console trace of the sign-in / authorization flow.
# On by default; set to false to silence it.
AUTH_TRACE=true
