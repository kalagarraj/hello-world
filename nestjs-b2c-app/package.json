{
  "name": "nestjs-b2c-hello-world",
  "version": "1.0.0",
  "description": "NestJS Hello World with Azure AD B2C authentication via openid-client (no MSAL)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "docker:build": "docker compose -f infra/docker-compose.yml build app",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:logs": "docker compose -f infra/docker-compose.yml logs -f app",
    "redis:up": "docker compose -f infra/docker-compose.yml up -d redis",
    "redis:down": "docker compose -f infra/docker-compose.yml down",
    "redis:reset": "docker compose -f infra/docker-compose.yml down -v",
    "redis:cli": "docker compose -f infra/docker-compose.yml exec redis redis-cli",
    "redis:logs": "docker compose -f infra/docker-compose.yml logs -f redis",
    "redis:sessions": "docker compose -f infra/docker-compose.yml exec redis redis-cli --scan --pattern 'sess:*'",
    "cosmos:up": "docker compose -f infra/docker-compose.cosmos.yml up -d",
    "cosmos:down": "docker compose -f infra/docker-compose.cosmos.yml down",
    "cosmos:logs": "docker compose -f infra/docker-compose.cosmos.yml logs -f",
    "snowflake:up": "docker compose -f infra/docker-compose.snowflake.yml up -d",
    "snowflake:down": "docker compose -f infra/docker-compose.snowflake.yml down",
    "snowflake:logs": "docker compose -f infra/docker-compose.snowflake.yml logs -f"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "connect-redis": "^10.0.0",
    "express-session": "^1.18.1",
    "hbs": "^4.2.0",
    "openid-client": "^5.7.1",
    "passport": "^0.7.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.10.0",
    "@types/passport": "^1.0.17",
    "typescript": "^5.7.0"
  }
}
